---
# Local overrides — copy to local.yml and fill in your values
# This file is gitignored — secrets stay local

# SSH user for masters and workers (VM username)
vm_username: "your-username-here"

# Sudo password (optional — omit and use --ask-become-pass instead)
# Or set ANSIBLE_BECOME_PASSWORD env var for CI/CD
# ansible_become_password: "your-sudo-password-here"

# Infrastructure overrides — uncomment to change from defaults
# domain: home.beabys.com            # DNS domain for *.home.beabys.com services
# metallb_ip_pool_range: 10.27.10.60-10.27.10.89  # MetalLB IP pool

# External databases to expose inside the cluster (playbook 09-external-db.yml)
# Keys per entry:
#   namespace:               Kubernetes namespace for the Service/EndpointSlice
#   database_name:           name of the Service/EndpointSlice (must be valid DNS-1123)
#   database_internal_port:  cluster port (Service .spec.ports[].port)
#   database_host_port:      port on the external database host
#   database_host:           IP or hostname of the external database
# external_databases:
#   - namespace: databases
#     database_name: mysql
#     database_internal_port: 3306
#     database_host_port: 3306
#     database_host: 10.27.10.37

# External Secrets Operator (playbook 11-external-secrets.yml) — provider connection config.

# AWS-compatible emulator endpoint. endpoint key decides the mode (no enabled flag):
#   endpoint ABSENT            -> real AWS Secrets Manager defaults (no failure).
#   endpoint set, non-empty    -> emulator mode; endpoint must be reachable FROM THE
#                                 CLUSTER (not localhost), e.g. http://10.27.10.38:4566.
#   endpoint set, empty string -> playbook fails (remove the var to use real AWS,
#                                 or set the URL).
# eso_aws_emulator:
#   endpoint: "http://10.27.10.38:4566"

# Static AWS credentials used against the emulator. This file is gitignored —
# secrets stay local. Key names are matched by the ClusterSecretStore auth.secretRef.
# eso_aws_credentials:
#   access_key_id: "test"
#   secret_access_key: "test"

# Cluster-wide SecretStores backed by AWS SecretsManager. A creds Secret
# (eso-aws-creds in the external-secrets namespace) plus one ClusterSecretStore
# is created per entry. Empty list -> operator-only install (no provider connection).
# Each entry:
#   name:     ClusterSecretStore name (must be valid DNS-1123)
#   region:   AWS region (default us-east-1)
#   service:  AWS service (default SecretsManager)
# eso_aws_cluster_stores:
#   - name: eso-aws
#     region: us-east-1
#     service: SecretsManager

